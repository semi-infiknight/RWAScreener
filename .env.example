# RWAScreener — copy to .env.local; never commit secrets.

# Helius (indexer / RPC stubs — fail closed when missing)
HELIUS_API_KEY=

# Bags live pad — required for /api/pads/bags (fail-closed if unset)
BAGS_API_KEY=

# Pad live-feed short TTL cache (lib/pad-cache.ts)
# Redis when set (Railway Redis plugin). Falls back to in-memory for local.
REDIS_URL=
# Railway private networking alias (optional; used if REDIS_URL unset)
REDIS_PRIVATE_URL=
# Cache TTL in seconds for pad list feeds (default 25; keep 20–30 for near-live)
PAD_CACHE_TTL_SECONDS=25
